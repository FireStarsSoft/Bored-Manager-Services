{
  "name": "bored-manager-services",
  "description": "Services module for Bored Manager - systemd services across every machine in an IP range: status wall, bulk start/stop/restart and bulk install",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "check": "npm run sdk:check && npm run typecheck && npm test && npm run specs && npm run compile",
    "compile": "tsx scripts/compile-module.mjs",
    "specs": "tsx scripts/check-specs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "agent:pack": "node scripts/package-agent.mjs dist",
    "agent:test": "python -m pytest agent/tests -q",
    "pack": "node scripts/package-module.mjs service-fleet dist",
    "sdk:check": "node scripts/sync-sdk.mjs --check",
    "sdk:drift": "node scripts/sync-sdk.mjs --against main",
    "sdk:sync": "node scripts/sync-sdk.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
