{
  "blocks": [
    {
      "type": "conditional",
      "when": {
        "source": { "kind": "stream", "event": "capabilities", "path": "ssh" },
        "op": "eq",
        "value": true
      },
      "blocks": [
        {
          "type": "section",
          "title": "Install a watched service everywhere it is missing",
          "blocks": [
            {
              "type": "checkForm",
              "checkMethod": "installCheck",
              "applyMethod": "installApply",
              "applyLabel": "Install it",
              "kind": "danger",
              "fields": [
                {
                  "key": "watchedId",
                  "label": "Service",
                  "input": "select",
                  "optionsFrom": { "kind": "invoke", "method": "selectOptions", "args": ["watched"] },
                  "help": "From the watched services list, so what gets installed is what gets checked afterwards."
                },
                {
                  "key": "hosts",
                  "label": "Machines",
                  "input": "text",
                  "placeholder": "10.0.0.*, lab-west",
                  "help": "Globs over the address or the rule label. Empty means every machine in the roster that the service applies to."
                },
                {
                  "key": "onlyMissing",
                  "label": "Only machines that do not have it",
                  "input": "checkbox",
                  "initial": true
                },
                {
                  "key": "refresh",
                  "label": "Refresh the package index first",
                  "input": "checkbox",
                  "help": "Needed on a machine that has never updated, and slower on every machine that has."
                },
                {
                  "key": "enable",
                  "label": "Enable it at boot after installing",
                  "input": "checkbox",
                  "initial": true
                },
                {
                  "key": "start",
                  "label": "Start it after installing",
                  "input": "checkbox",
                  "initial": true
                }
              ]
            }
          ]
        },
        {
          "type": "section",
          "title": "Watched services",
          "blocks": [
            {
              "type": "table",
              "source": { "kind": "invoke", "method": "watched", "intervalKey": "service-fleet" },
              "rowKey": "id",
              "columns": [
                { "key": "unit", "label": "Service" },
                { "key": "severity", "label": "Severity" },
                { "key": "appliesTo", "label": "Applies to" },
                { "key": "machines", "label": "Machines", "format": "number", "align": "right" },
                { "key": "down", "label": "Not running", "format": "number", "align": "right" },
                { "key": "packages", "label": "Package" },
                { "key": "onInstall", "label": "After install" }
              ],
              "sortDefault": { "key": "unit", "dir": "asc" },
              "emptyText": "No watched services yet - add one under Module settings"
            }
          ]
        },
        {
          "type": "section",
          "title": "Jobs",
          "blocks": [
            {
              "type": "table",
              "source": { "kind": "stream", "event": "jobs", "path": "jobs" },
              "rowKey": "id",
              "columns": [
                { "key": "label", "label": "Job" },
                { "key": "state", "label": "State" },
                { "key": "progressPct", "label": "Progress", "format": "pct", "align": "right" },
                { "key": "done", "label": "Done", "format": "number", "align": "right" },
                { "key": "total", "label": "Machines", "format": "number", "align": "right" },
                { "key": "failed", "label": "Failed", "format": "number", "align": "right" },
                { "key": "startedAt", "label": "Started", "format": "duration", "align": "right" }
              ],
              "sortDefault": { "key": "startedAt", "dir": "desc" },
              "emptyText": "Nothing has been run yet",
              "rowActions": [
                {
                  "label": "Cancel",
                  "method": "jobCancel",
                  "argsFromRow": ["id"],
                  "confirm": "Stop this job? Machines already being contacted will finish.",
                  "kind": "danger"
                }
              ],
              "rowDetail": [
                {
                  "type": "list",
                  "source": { "kind": "stream", "event": "jobs", "path": "$row.items" },
                  "columns": [
                    { "key": "name", "label": "Machine" },
                    { "key": "status", "label": "Result" },
                    { "key": "message", "label": "Message" }
                  ],
                  "limit": 200,
                  "emptyText": "No machines in this job"
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "type": "section",
          "title": "Nothing can be installed from here",
          "blocks": [
            {
              "type": "keyValue",
              "source": { "kind": "stream", "event": "capabilities" },
              "rows": [
                { "key": "problem", "label": "Problem" },
                { "key": "connected", "label": "Connected to a machine" },
                { "key": "ssh", "label": "Has ssh" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
