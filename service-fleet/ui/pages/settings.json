                {
                  "id": "agent",
                  "label": "Agent and storage",
                  "blocks": [
                    {
                      "type": "conditional",
                      "when": {
                        "source": {
                          "kind": "stream",
                          "event": "ui",
                          "path": "hintsOn"
                        },
                        "op": "eq",
                        "value": true
                      },
                      "blocks": [
                        {
                          "type": "note",
                          "title": "What this module installs",
                          "lines": [
                            "BoredAgent: a small daemon that runs your services, watches the connection once a second, and keeps a year of daily figures. It runs as its own user, not as root.",
                            "The version and hash below are what this build of the module was made against. Installing checks the download against that hash on the target machine itself, and refuses if it does not match."
                          ]
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "title": "The agent this module installs",
                      "blocks": [
                        {
                          "type": "keyValue",
                          "source": {
                            "kind": "stream",
                            "event": "ui"
                          },
                          "rows": [
                            {
                              "key": "agentVersion",
                              "label": "Version"
                            }
                          ]
                        },
                        {
                          "type": "note",
                          "title": "Where to install it",
                          "lines": [
                            "Agent installs are on the Machines page, where the list of machines is. This page is only about what would be installed."
                          ],
                          "tone": "info"
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "title": "What this module is storing",
                      "blocks": [
                        {
                          "type": "conditional",
                          "when": {
                            "source": {
                              "kind": "stream",
                              "event": "ui",
                              "path": "hintsOn"
                            },
                            "op": "eq",
                            "value": true
                          },
                          "blocks": [
                            {
                              "type": "note",
                              "title": "Where it goes",
                              "lines": [
                                "Daily figures and incidents are kept by the app, not by this module - it declares how much it needs and the app grants it. Settings → Data & storage shows every module's share side by side.",
                                "The agents keep their own copy too, for over a year, which is what lets this catch up after being switched off."
                              ]
                            }
                          ]
                        },
                        {
                          "type": "keyValue",
                          "source": {
                            "kind": "invoke",
                            "method": "storageUsage"
                          },
                          "rows": [
                            {
                              "key": "totalBytes",
                              "label": "Total",
                              "format": "bytes"
                            },
                            {
                              "key": "recordBytes",
                              "label": "Daily figures and incidents",
                              "format": "bytes"
                            },
                            {
                              "key": "configBytes",
                              "label": "Settings and templates",
                              "format": "bytes"
                            },
                            {
                              "key": "hostDataBytes",
                              "label": "Per-machine notes",
                              "format": "bytes"
                            },
                            {
                              "key": "historyBytes",
                              "label": "Charts",
                              "format": "bytes"
                            }
                          ]
                        },
                        {
                          "type": "table",
                          "source": {
                            "kind": "invoke",
                            "method": "storageUsage",
                            "path": "sets"
                          },
                          "columns": [
                            {
                              "key": "label",
                              "label": "Kept"
                            },
                            {
                              "key": "rows",
                              "label": "Rows",
                              "align": "right"
                            },
                            {
                              "key": "bytes",
                              "label": "Size",
                              "format": "bytes",
                              "align": "right"
                            },
                            {
                              "key": "grantedBytes",
                              "label": "Allowed",
                              "format": "bytes",
                              "align": "right"
                            },
                            {
                              "key": "retentionDays",
                              "label": "Days kept",
                              "align": "right"
                            },
                            {
                              "key": "oldestMs",
                              "label": "Oldest",
                              "format": "time"
                            },
                            {
                              "key": "newestMs",
                              "label": "Newest",
                              "format": "time"
                            }
                          ],
                          "rowKey": "id",
                          "emptyText": "Nothing stored yet. Collection runs on its own timer, and the first pull brings whatever the agents already had."
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "display",
                  "label": "Display",
                  "blocks": [
                    {
                      "type": "section",
                      "title": "Display",
                      "columns": 2,
                      "blocks": [
                        {
                          "type": "conditional",
                          "when": {
                            "source": {
                              "kind": "stream",
                              "event": "ui",
                              "path": "hintsOn"
                            },
                            "op": "eq",
                            "value": true
                          },
                          "blocks": [
                            {
                              "type": "note",
                              "title": "What this changes",
                              "lines": [
                                "The explanatory notes on every page of this module. Turning them off leaves the tables, forms and figures - and every banner that says something is wrong, which is never hidden."
                              ]
                            }
                          ]
                        },
                        {
                          "type": "form",
                          "fields": [
                            {
                              "key": "hintsOn",
                              "label": "Show the explanatory notes on every Services page",
                              "input": "checkbox",
                              "initialFrom": {
                                "kind": "stream",
                                "event": "ui",
                                "path": "hintsOn"
                              }
                            }
                          ],
                          "submit": {
                            "label": "Save",
                            "method": "hintsSet"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "rules",
                  "label": "Rules",
                  "blocks": [
                    {
                      "type": "section",
                      "title": "Rules in force",
                      "blocks": [
                        {
                          "type": "keyValue",
                          "source": {
                            "kind": "invoke",
                            "method": "rulesEffective"
                          },
                          "rows": [
                            {
                              "key": "maxParallel",
                              "label": "Machines contacted at once"
                            },
                            {
                              "key": "connectTimeoutSec",
                              "label": "Connect timeout (s)"
                            },
                            {
                              "key": "perHostTimeoutSec",
                              "label": "Per-machine timeout (s)"
                            },
                            {
                              "key": "sweepTimeoutSec",
                              "label": "Whole sweep timeout (s)"
                            },
                            {
                              "key": "controlPersistSec",
