                                          "label": "sudo with a password"
                                        }
                                      ]
                                    },
                                    {
                                      "key": "sudoPassword",
                                      "label": "Sudo password",
                                      "input": "password",
                                      "omitOnApply": true
                                    },
                                    {
                                      "key": "excludes",
                                      "label": "Addresses to skip",
                                      "input": "text",
                                      "placeholder": "192.168.1.1, 192.168.1.254"
                                    }
                                  ],
                                  "argsFromScope": [
                                    "id"
                                  ],
                                  "checkLabel": "Check",
                                  "applyLabel": "Save"
                                }
                              ]
                            }
                          ],
                          "emptyText": "No addresses yet. Add one below - a single machine, a CIDR block like 192.168.1.0/24, or a range like 192.168.1.10-40."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "title": "Add an address rule",
                      "columns": 2,
                      "blocks": [
                        {
                          "type": "conditional",
                          "when": {
                            "source": {
                              "kind": "stream",
                              "event": "ui",
                              "path": "hintsOn"
                            },
                            "op": "eq",
                            "value": true
                          },
                          "blocks": [
                            {
                              "type": "note",
                              "title": "What each field means",
                              "lines": [
                                "Kind - one machine, a CIDR block, or a range. A block or a range is swept; only addresses that answer become machines, so watching a /24 does not draw 254 dead cards.",
                                "Address - 192.168.1.5, or 192.168.1.0/24, or 192.168.1.10-40.",
                                "Label - your name for this group. It shows on every machine the rule covers.",
                                "Login and Authentication - how to log in. \"agent\" uses the SSH agent on the machine you are connected to, \"key\" a private key path on that machine, \"password\" a password stored here in clear text.",
                                "Sudo - the agent installer needs root. Either log in as root, or choose a sudo mode; \"sudo -n\" needs passwordless sudo already configured.",
                                "A narrower rule wins: one machine given its own login inside a subnet-wide rule is reached the way you meant."
                              ]
                            }
                          ]
                        },
                        {
                          "type": "checkForm",
                          "checkMethod": "targetCheck",
                          "applyMethod": "targetApply",
