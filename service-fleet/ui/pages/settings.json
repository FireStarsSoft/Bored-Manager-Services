                              "input": "text",
                              "placeholder": "192.168.1.5  or  192.168.1.0/24  or  192.168.1.10-40"
                            },
                            {
                              "key": "label",
                              "label": "Label",
                              "input": "text"
                            },
                            {
                              "key": "enabled",
                              "label": "Sweep this rule",
