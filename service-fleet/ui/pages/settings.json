                              "label": "Warn on bulk action size"
                            },
                            {
                              "key": "installWarnAt",
                              "label": "Warn on agent install size"
                            },
                            {
                              "key": "telemetryEveryMin",
                              "label": "Pull telemetry every (min)"
                            },
                            {
                              "key": "telemetryBackfillDays",
                              "label": "First-pull backfill (days)"
                            },
                            {
                              "key": "maxTemplates",
                              "label": "User templates kept"
