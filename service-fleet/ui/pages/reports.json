                              "format": "bytes",
                              "align": "right"
                            },
                            {
                              "key": "tx",
                              "label": "Sent",
                              "format": "bytes",
                              "align": "right"
                            },
                            {
                              "key": "bytes",
                              "label": "Total",
                              "format": "bytes",
                              "align": "right"
                            },
                            {
                              "key": "partialBadges",
                              "label": "Exactness",
                              "format": "badges",
                              "sortable": false
                            },
                            {
                              "key": "uptimePct",
                              "label": "Up %",
                              "align": "right"
                            },
                            {
                              "key": "restarts",
                              "label": "Restarts",
                              "align": "right"
                            }
                          ],
                          "rowKey": "key",
                          "sortDefault": {
                            "key": "day",
                            "dir": "desc"
                          },
                          "filterKeys": [
                            "ip",
                            "label",
                            "template",
                            "unit",
                            "day"
                          ],
                          "groupModes": [
                            {
                              "id": "machine",
                              "label": "By machine",
                              "key": "ip"
                            },
                            {
                              "id": "template",
                              "label": "By service",
                              "key": "template"
                            },
                            {
                              "id": "day",
                              "label": "By day",
                              "key": "day"
                            }
                          ],
                          "emptyText": "Nothing collected yet. Agents write one row per day, so the first appears after a day of running - or immediately if an agent already had history when it was found."
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "uptime",
                  "label": "Uptime",
                  "blocks": [
                    {
                      "type": "conditional",
                      "when": {
                        "source": {
                          "kind": "stream",
                          "event": "ui",
                          "path": "hintsOn"
                        },
                        "op": "eq",
                        "value": true
                      },
                      "blocks": [
                        {
                          "type": "note",
                          "title": "What uptime means here",
                          "lines": [
                            "The share of the day an agent could reach the internet, measured by its own probe once a second against four different operators.",
                            "Time the agent was not running at all counts as neither up nor down - it is recorded as a gap, on the Incidents tab, rather than silently counted as perfect uptime."
                          ]
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "title": "Fleet",
                      "columns": 2,
                      "blocks": [
                        {
                          "type": "meter",
                          "label": "Average online time",
                          "source": {
                            "kind": "invoke",
                            "method": "reportUptimeSummary",
                            "args": [
                              30
                            ],
                            "path": "onlinePct"
                          },
                          "format": "pct",
                          "max": 100
                        },
                        {
                          "type": "keyValue",
                          "source": {
                            "kind": "invoke",
                            "method": "reportUptimeSummary",
                            "args": [
                              30
                            ]
                          },
                          "rows": [
                            {
                              "key": "machines",
                              "label": "Machines with history"
                            },
                            {
                              "key": "days",
                              "label": "Window (days)"
                            },
                            {
                              "key": "incidents",
                              "label": "Incidents recorded"
                            },
                            {
                              "key": "message",
                              "label": "Summary"
                            }
                          ]
                        }
                      ]
                    },
